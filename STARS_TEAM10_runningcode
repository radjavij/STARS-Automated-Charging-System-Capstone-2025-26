  //HARDWARE + GS CONTROLLER SETUP
  Serial.begin(19200);
  pixy.init();
  vcnl.begin();  

  pinMode(MOTOR_AIN1, OUTPUT);
  pinMode(MOTOR_AIN2, OUTPUT);
  pinMode(MOTOR_BIN1, OUTPUT);
