  pinMode(LED_DAT_OUT, OUTPUT);
  
  strip.begin();
  strip.clear();

  setup_wifi();
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqtt_callback);
  Serial.println("Robot initialized with communication enabled");
  
  randomSeed(analogRead(A0)); //Resets random seed to ensure different random motion occurs on every move
  isInDelay = false; 

  strip.show();
  setLED(COLOR_MAGENTA);
  Serial.println("[SETUP COMPLETE]");
}

