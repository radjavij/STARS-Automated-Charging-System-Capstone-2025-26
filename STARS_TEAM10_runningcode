// READS BATTERY VOLTAGE
double get_bat_voltage(int pin = BAT_RESISTOR_1_2, double divided_max = 2.935, double max_bat_voltage = 4.2) {
  return (((double)analogRead(pin)) * max_bat_voltage) / ((divided_max / 3.3) * 1023);
}
// RETURNS BATTERY VOLTAGE 
void checkBatteryVoltage() {
  currentBatVoltage = get_bat_voltage();
}
// SETS THE COLOR OF THE ONBOARD LED
void setLED(uint32_t color) {
  currentLedColor = color;
  strip.setPixelColor(0, color);
  strip.show();
}
// COMMANDS MOVES BY ALTERING L/R MOTOR DIRECTION AND SPEED
void setMotorDirection(bool leftFwd, bool rightFwd, int leftSpeed, int rightSpeed) {
  analogWrite(MOTOR_AIN1, leftSpeed);
  digitalWrite(MOTOR_AIN2, leftFwd ? LOW : HIGH);
  analogWrite(MOTOR_BIN1, rightSpeed);
  digitalWrite(MOTOR_BIN2, rightFwd ? LOW : HIGH);
}
// STOPS BOTH MOTORS TO COMMAND STOPS
void stopMotors() {
  analogWrite(MOTOR_AIN1, 0);
  analogWrite(MOTOR_BIN1, 0);
  digitalWrite(MOTOR_AIN2, LOW);
  digitalWrite(MOTOR_BIN2, LOW);
}
// CURVED RANDOM WALK MOTION GENERATOR
void randomCurve() {
  currentMotionType = random(0, 3);  // 0 = forward, 1 = curve left, 2 = curve right
  moveStartTime = millis();
  // For curves you might choose different durations:
  if (currentMotionType == 0) {
    moveDuration = random(FORWARD_MIN_DURATION, FORWARD_MAX_DURATION);
  } else {
    moveDuration = random(TURN_MIN_DURATION, TURN_MAX_DURATION);
  }
  if (currentMotionType == 1) {
    // Curve left
    setMotorDirection(true, true, CURVE_SPEED, BASE_SPEED);
  } else if (currentMotionType == 2) {
    // Curve right
    setMotorDirection(true, true, BASE_SPEED, CURVE_SPEED);
  } else {
    // Straight forward
    setMotorDirection(true, true, BASE_SPEED, BASE_SPEED);
  }
  isInDelay = false;  // ensure motion state
}
//BOOL OBSTACLE DETECTOR
bool isObstacleAhead() {
  uint16_t prox = vcnl.readProximity();
  return prox > PROXIMITY_THRESHOLD;
}
//FSM LOGIC HANDLER
void handleObstacle() {
  unsigned long now = millis();

  switch (obstacleState) {
    case NONE:
      if (isObstacleAhead()) {
        stopMotors();
        setLED(COLOR_GREEN);
        obstacleStartTime = now;
        obstacleState = STOPPED;
      }
    break;

    case STOPPED:
      if (now - obstacleStartTime >= 200) {
        setLED(COLOR_RED);
        obstacleStartTime = now;
        obstacleState = WAITING;
      }
    break;

    case WAITING:
      if (now - obstacleStartTime >= AVOID_WAIT_TIME) {
        if (isObstacleAhead()) {
          setLED(COLOR_BLUE);
          avoidLeft = random(0, 2);
          obstacleStartTime = now;
          obstacleState = AVOIDING;

          //Move back a little to make sure unit wont collide with wall
          setMotorDirection(false, false, TURN_SPEED, TURN_SPEED);
          delay(AVOID_REVERSE_PULSE);
          stopMotors();

          if (avoidLeft) {
            setMotorDirection(false, true, TURN_SPEED, TURN_SPEED);
          } else {
            setMotorDirection(true, false, TURN_SPEED, TURN_SPEED);
          }
        } else {
          obstacleState = NONE;
          strip.clear();
        }
      }
    break;

    case AVOIDING:
      if (now - obstacleStartTime >= 500) {
        stopMotors();
        obstacleStartTime = now;
        obstacleState = NONE;
      }
    break;
  }
}
//STALL BLOCKER - Limits di/dt to blunt instantaneous powerdraw
void stallblock() {
  // If kick already completed, do nothing
  if (motorKickDone) return;

  unsigned long now = millis();

  // First entry
  if (kickStartTime == 0) {
    kickStartTime = now;
  }

  unsigned long elapsed = now - kickStartTime;

  if (elapsed >= KS_MS) {
    // Ramp complete
    setMotorDirection(true, true, TURN_SPEED, TURN_SPEED);
    motorKickDone = true;
    kickStartTime = 0;   // reset for next GOTO
    return;
  }

  // Linear ramp 0 -> CURVE_SPEED
  int pwm = map(elapsed, 0, KS_MS, 0, TURN_SPEED);
  pwm = constrain(pwm, 0, TURN_SPEED);

  setMotorDirection(true, true, pwm, pwm);
}
