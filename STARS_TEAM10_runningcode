// MQTT TELEMETRY MANAGER
void handleCommunication() {
  unsigned long currentTime = millis();
  
  // Check if it's time to send LED status
  if (currentTime - lastLedStatusTime >= LED_STATUS_INTERVAL) {
    sendLedStatus();
    lastLedStatusTime = currentTime;
  }
  
  // Check if it's time to send proximity status
  if (currentTime - lastProxStatusTime >= PROX_STATUS_INTERVAL) {
    sendProxStatus();
    lastProxStatusTime = currentTime;
  }
  
  // Check if it's time to send battery status
  if (currentTime - lastBatStatusTime >= BAT_STATUS_INTERVAL) {
    sendBatStatus();
    lastBatStatusTime = currentTime;
  }
  // Check if it's time to send color detection status
  if (currentTime - lastColorStatusTime >= COLOR_STATUS_INTERVAL) {
    sendColorStatus();
    lastColorStatusTime = currentTime;
  }
  // Check if it's time to send battery status
  if (currentTime - lastModeStatusTime >= MODE_STATUS_INTERVAL) {
    sendModeStatus();
    lastModeStatusTime = currentTime;
  }
}
// MQTT GS MODE INTERPRETER
void mqtt_callback(char* topic, byte* payload, unsigned int length) {
  // Ignore /pose topic messages completely
  if (strstr(topic, "/pose")) {
    // Parse JSON (optional, if you still need the data)
    StaticJsonDocument<256> doc;
    DeserializationError error = deserializeJson(doc, payload, length);
    if (error) return;

    cX = doc["x"];
    cY = doc["y"];
    cH = doc["head"];
    return;
  }

  // Debug output for all other topics
  Serial.print("[MQTT] RX: ");
  Serial.println(topic);

  // Deserialize JSON
  StaticJsonDocument<256> doc;
  DeserializationError error = deserializeJson(doc, payload, length);
  if (error) {
    Serial.print("JSON parse failed: ");
    Serial.println(error.c_str());
    return;
  }

  StaticJsonDocument<64> ack;

  // Handle command updates
  if (strstr(topic, "/cmd")) {
    const char* mode = doc["MD"];
    

    if (!mode) {
      Serial.println("No mode field in command message.");
      return;
    }

    if (strcmp(mode, "SB") == 0) {
      currentMode = STANDBY;
      Serial.println("[MODE] Standby");
      sendModeStatus();

    } else if (strcmp(mode, "MS") == 0) {
      currentMode = MISSION;
      Serial.println("[MODE] Mission");
      sendModeStatus();

    } else if (strcmp(mode, "GT") == 0) {
      tX = doc["x"];
      tY = doc["y"];
      tH = doc["head"];
      gotoStartTime = millis();
       PosAcheived   = false;
       motorKickDone = false;
       kickStartTime = 0;
      currentMode = GOTO;
      Serial.println("[MODE] Go-To");
      sendModeStatus();

      Serial.print("[GOTO] Target: (");
      Serial.print(tX);
      Serial.print(", ");
      Serial.print(tY);
      Serial.print(") Heading: ");
      Serial.println(tH);

    } else if (strcmp(mode, "CG") == 0) {
      currentMode = CHARGE;
      Serial.println("[MODE] Charge");
      sendModeStatus();

    } else {
      Serial.print("[MODE] Unkown:  ");
      Serial.println(mode);
    }
    ack["MD"] = mode;
    ack["stat"] = "rcvd";
    char buffer[64];
    serializeJson(ack, buffer);
    mqttClient.publish(("UI/" + String(unit_id) + "/ack").c_str(), buffer);
  }
  
}
// GOTO mode handler
void modeGoto() {
  //GOTO MODE TIMEOUT - ADJUST ABOVE IN GOTO SETTINGS
  if (millis() - gotoStartTime > gotoTimeoutMs) {
    stopMotors();
    currentMode = STANDBY;
    Serial.println("[WARN] Goto timeout. Aborting and returning to STANDBY.");
    return;
  }
  // MOTOR ANTI-STALL RAMPING KICKSTART
  if (!motorKickDone) {
    stallblock();
    return;  // wait until kick is complete before control logic
  }
  //LOCAL VARIABLE INTIALISATION
  float dx = tX - cX;
  float dy = tY - cY;
  float dist = sqrt(dx*dx + dy*dy);
  float desiredAngle = atan2(dx, -dy) * (180.0 / PI);
  float errHead = desiredAngle - cH;
  //Serial.print("[GOTO-DEBUG] {dx: ");
  //Serial.print(dx, 2);
  //Serial.print(", dy: ");
  //Serial.print(dy, 2);
  //Serial.print(", dh: ");
  //Serial.print(errHead, 2);
  //Serial.println("}");
  // normalize to ±180
  if (errHead > 180)  errHead -= 360;
  if (errHead < -180) errHead += 360;

  if (dist > gotoPosTol) {
    // rotate‑and‑drive with proportional heading control
    int corr = (int)(kP_heading * errHead);
    //int corr = constrain(corr, -60, 60); //Overcontraints the Heading Error - 013026
    setMotorDirection(true, true, constrain(CURVE_SPEED + corr, MIN_SPEED, 255), constrain(CURVE_SPEED - corr, MIN_SPEED, 255));

  } else {
    stopMotors();
    if (!PosAcheived) {
      Serial.println("[INFO] Position reached. GOTO complete.");
      PosAcheived = true;
      currentMode = STANDBY;
      sendModeStatus();
    }
  }
}
