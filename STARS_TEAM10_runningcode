// MAIN LOOP
void loop() {
  // MAINTAINS MQTT CONNECTIONS
  if (!mqttClient.connected()) {
    reconnect_mqtt();
  }

  // HANDLER FUNCTIONS
  mqttClient.loop();      // MQTT "Im Alive" ping
  handleCommunication();  // Telemetry Handler
  handleObstacle();       // Hardware proximity detection updater
  
  if (obstacleState == NONE) {
    switch (currentMode) {
      case STANDBY:
        stopMotors();
        break;

      case GOTO:
        modeGoto();
        break;

      case CHARGE:
        modeCharge();
        break;

      case MISSION:
        Serial.println("Debug - MISSION");
      break;

    }
  }
}
